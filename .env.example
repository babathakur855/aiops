# aiops (OpsBrain) — Environment Variables
# ==========================================
# Port assignment: Backend 8011 | Frontend 3010

# Shared Anthropic API Key for all use-cases
ANTHROPIC_API_KEY=

# App ports (do not change — shared port registry across all use-cases)
BACKEND_PORT=8011
FRONTEND_PORT=3010
NEXT_PUBLIC_API_URL=http://localhost:8011
NEXT_PUBLIC_WS_URL=ws://localhost:8011
